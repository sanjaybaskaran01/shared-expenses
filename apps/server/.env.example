NODE_ENV=production
APP_VERSION=0.1.0
EXPENSES_BUN_PATH=/opt/homebrew/bin/bun
EXPENSES_SERVER_ENTRY=
PORT=3000
HOST=127.0.0.1
# Direct Bun development uses the defaults below. Leave them commented when
# using Docker Compose: it supplies persistent /data storage and one origin.
# DATABASE_PATH=./data/expenses.sqlite
# ATTACHMENTS_PATH=./data/attachments
# WEB_ORIGIN=http://localhost:5173
# PUBLIC_API_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_SECRET_KEYCHAIN_SERVICE=
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET_KEYCHAIN_SERVICE=
SPLITWISE_API_APPROVED=false
SPLITWISE_CLIENT_ID=
SPLITWISE_CLIENT_SECRET=
SPLITWISE_REDIRECT_URI=
# The v2 confidential-sync API is experimental and the shipped UI does not use it.
EXPERIMENTAL_CONFIDENTIAL_SYNC=false
DEV_AUTH_BYPASS=false
TRUST_CLOUDFLARE_PROXY=false
TRUSTED_PROXY_CIDRS=
OWNER_EMAIL=you@example.com
BOOTSTRAP_GROUP_NAME=Shared expenses
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_APP_PASSWORD_KEYCHAIN_SERVICE=
SMTP_FROM=Tallied <tally@example.com>
