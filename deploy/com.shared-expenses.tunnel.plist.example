<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.shared-expenses.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_RUN_TUNNEL_SCRIPT_PATH</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLOUDFLARED_PATH</key><string>REPLACE_WITH_CLOUDFLARED_PATH</string>
    <key>CLOUDFLARED_PROTOCOL</key><string>auto</string>
    <key>CLOUDFLARED_TOKEN_KEYCHAIN_ACCOUNT</key><string>REPLACE_WITH_MACOS_USERNAME</string>
    <key>CLOUDFLARED_TOKEN_KEYCHAIN_SERVICE</key><string>shared-expenses-tunnel</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>REPLACE_WITH_DATA_PATH/logs/tunnel.log</string>
  <key>StandardErrorPath</key><string>REPLACE_WITH_DATA_PATH/logs/tunnel.error.log</string>
</dict>
</plist>
