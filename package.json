{
  "name": "shared-expenses",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "scripts": {
    "dev": "bun --filter @expenses/server --filter @expenses/web dev",
    "dev:server": "bun --filter @expenses/server dev",
    "dev:web": "bun --filter @expenses/web dev",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "build": "bun --filter @expenses/protocol build && bun --filter @expenses/web build && bun --filter @expenses/server build",
    "assets": "bun apps/web/scripts/generate-assets.ts",
    "recovery:new-generation": "bun scripts/rotate-generation.ts",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
