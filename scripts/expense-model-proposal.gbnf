# Fixed-order JSON grammar for the benchmark's ExpenseModelProposal contract.
# It intentionally permits duplicate array values; the application validator
# remains responsible for semantic checks after constrained decoding.

root ::= ws "{" ws "\"kind\"" ws ":" ws kind "," ws "\"descriptionText\"" ws ":" ws nullable-string "," ws "\"merchantText\"" ws ":" ws nullable-string "," ws "\"amountText\"" ws ":" ws nullable-string "," ws "\"currency\"" ws ":" ws currency "," ws "\"dateText\"" ws ":" ws nullable-string "," ws "\"payerMemberIds\"" ws ":" ws member-list "," ws "\"payerAllocations\"" ws ":" ws allocation-list "," ws "\"participantMode\"" ws ":" ws participant-mode "," ws "\"participantMemberIds\"" ws ":" ws member-list "," ws "\"unresolvedPeople\"" ws ":" ws string-list "," ws "\"splitMethod\"" ws ":" ws split-method "," ws "\"allocations\"" ws ":" ws allocation-list "," ws "\"recurrence\"" ws ":" ws recurrence "," ws "\"requiresReview\"" ws ":" ws review-list ws "}" ws

kind ::= "\"expense\"" | "\"not-expense\""
nullable-string ::= string | "null"
currency ::= "\"USD\"" | "\"EUR\"" | "\"INR\"" | "\"GBP\"" | "\"CAD\"" | "null"
participant-mode ::= "\"explicit-only\"" | "\"use-defaults\"" | "\"unspecified\""
split-method ::= "\"equal\"" | "\"exact\"" | "\"percentage\"" | "\"shares\"" | "\"adjustment\"" | "\"unspecified\""
recurrence ::= "\"none\"" | "\"weekly\"" | "\"fortnightly\"" | "\"monthly\"" | "\"yearly\"" | "\"unspecified\""

member ::= "\"me\"" | "\"matt\"" | "\"alex\"" | "\"ananya\""
member-list ::= "[" ws "]" | "[" ws member (ws "," ws member)* ws "]"
allocation ::= "{" ws "\"memberId\"" ws ":" ws member ws "," ws "\"valueText\"" ws ":" ws string ws "}"
allocation-list ::= "[" ws "]" | "[" ws allocation (ws "," ws allocation)* ws "]"
string-list ::= "[" ws "]" | "[" ws string (ws "," ws string)* ws "]"
review ::= "\"ambiguous-member\"" | "\"ambiguous-date\"" | "\"ambiguous-fact\"" | "\"conflicting-facts\"" | "\"hedged-split\"" | "\"invalid-split\"" | "\"missing-amount\"" | "\"missing-description\"" | "\"multiple-expenses\"" | "\"not-an-expense\"" | "\"non-positive-amount\"" | "\"payer-unspecified\"" | "\"refund-or-transfer\"" | "\"untrusted-instruction\"" | "\"unknown-person\""
review-list ::= "[" ws "]" | "[" ws review (ws "," ws review)* ws "]"

string ::= "\"" char* "\""
char ::= [^"\\\x00-\x1F] | "\\" escape
escape ::= ["\\/bfnrt] | "u" hex hex hex hex
hex ::= [0-9a-fA-F]
ws ::= [ \t\n]*
